LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434

# ---- Postgres ---------------------------------------------------------------
# The app connects as the restricted nirn_app role (SELECT/INSERT/UPDATE/DELETE
# only — see backend/README.md for the GRANT statements). Migrations run as a
# more privileged owner role via ALEMBIC_DATABASE_URL (see backend/alembic/env.py).
#
# TEAM SETUP: point this at the shared database (ask whoever ran
# backend/scripts/init_db.sh for the real value) — see backend/README.md §0.
# Note: asyncpg wants ?ssl=require, NOT ?sslmode=require (that's a
# psycopg2/libpq param and will crash with "unexpected keyword argument
# 'sslmode'"). init_db.sh already rewrites this for you.
DATABASE_URL=postgresql+asyncpg://nirn_app:CHANGEME@localhost:5432/nirn_ai

# ---- Auth ---------------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGEME
