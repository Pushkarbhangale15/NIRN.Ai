LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434

# ---- Postgres ---------------------------------------------------------------
# The app connects as the restricted nirn_app role (SELECT/INSERT/UPDATE/DELETE
# only — see backend/README.md for the GRANT statements). Migrations run as a
# more privileged owner role via ALEMBIC_DATABASE_URL (see backend/alembic/env.py).
DATABASE_URL=postgresql+asyncpg://nirn_app:CHANGEME@localhost:5432/nirn_ai

# ---- Auth ---------------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGEME
