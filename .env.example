# Copy this file to .env at the project root and fill in real values.
# .env is gitignored; this file is not — never put a real credential
# in here, only CHANGEME placeholders.

# ---- LLM provider (local, offline) ----------------------------------
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434

# ---- Local PostgreSQL -------------------------------------------------
# Used by the running app (asyncpg driver). The password must match
# whatever you pass as NIRN_APP_PASSWORD to
# backend/scripts/setup_local_db.sh.
DATABASE_URL=postgresql+asyncpg://nirn_app:CHANGEME@localhost:5432/nirn_ai

# Used only by Alembic to run migrations (sync driver, superuser —
# DDL privileges). Never used by the running app.
ALEMBIC_DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5432/nirn_ai

# ---- Auth ---------------------------------------------------------------
# Any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGEME
